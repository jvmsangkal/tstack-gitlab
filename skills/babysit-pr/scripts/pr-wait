#!/usr/bin/env python3
"""pr-wait: watch one GitLab merge request and print one line per real event.

  pr-wait <mr> [--repo group/project] [--until green|ready|any-change] [--interval 20]

<mr> is an MR IID (123, !123, #123), group/project!123, or an MR URL. Without
--repo, the project comes from the URL or from the current checkout. The host
comes from the URL, else GITLAB_HOST, else glab's default (the checkout's
remote, else gitlab.com). Stdout carries only events, one line each, so a
monitor (Claude Code's Monitor tool) wakes the agent once per real event.
Progress and errors that do not end the run go to stderr.

--until
  green       required jobs passed on the current head: head-pipeline jobs
              that may not fail, external commit statuses, and MR status checks
  ready       green, Greptile or Macroscope reviewed the current head, and no
              thread is unresolved (default)
  any-change  stop after the first poll that prints an event

Exit codes
  0  the --until condition is met, or the MR merged
  1  the condition cannot be met without action: a required job failed, the
     branch conflicts with its target, the MR closed, `ready` is blocked by
     unresolved threads or a branch that needs a rebase, or GitLab stayed
     unreachable
  2  bad arguments, unknown MR, a host glab has no login for, or another
     pr-wait already watches this MR

Events
  - a required job failed (name and link)
  - all jobs finished on the head (one summary line)
  - a new comment, approval, change request, thread, or thread reply from
    someone other than the MR author or the glab user
  - Greptile, Macroscope, or CodeRabbit finished on the head, or a Greptile or
    Macroscope summary changed after that
  - the target branch moved and the new commits touch files in this MR
  - merge state became BEHIND (need_rebase) or DIRTY (conflict)
  - the MR merged or closed

CodeRabbit is advisory: pr-wait reports it but never waits for it. System
notes (pushes, approvals, label changes) and comment edits are never events,
and top-level comments from CI and deploy bots (gitlab-bot, Vercel) are
skipped, because jobs already carry that news.

Auth comes from glab only: `glab auth login --hostname <host>`, or GITLAB_TOKEN
for gitlab.com and for the GITLAB_HOST host. pr-wait never reads or passes a
token. glab sends no token to a host it has no login for, so pr-wait refuses
such a host instead of polling it anonymously.

State lives in ~/.local/state/pr-wait/. A lock makes a second watcher for the
same MR exit at once. A state file lets a restarted watcher report what arrived
while no watcher ran. The first run for an MR records what already exists and
reports only what comes after.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import html
import json
import os
import re
import subprocess
import sys
import time
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Any, NoReturn
from urllib.parse import quote, urlparse

GATING_BOTS = ("greptile", "macroscope")
ADVISORY_BOTS = ("coderabbit",)
# CI and deploy bots report through jobs and statuses. Their MR comments are status reports.
STATUS_BOTS = ("gitlab-bot", "vercel", "netlify", "railway", "cloudflare")
STATE_DIR = Path.home() / ".local" / "state" / "pr-wait"
# A state file older than this describes an old session. Start a fresh baseline
# instead of replaying hours of comments as new events.
STALE_STATE_SECONDS = 6 * 3600
MAX_FAILED_POLLS = 10
TRANSIENT = re.compile(
    r"HTTP (5\d\d|429)|rate limit|too many requests|retry-after|bad gateway|service unavailable|"
    r"timed? ?out|deadline exceeded|connection (reset|refused)|EOF|temporar|could not resolve host|"
    r"no such host|network is unreachable|error connecting to|TLS handshake|Something went wrong",
    re.IGNORECASE,
)
# Older glab exits 0 after an HTTP error, so the status on stderr decides.
HTTP_STATUS = re.compile(r"\(HTTP (\d{3})\)")
# glab's update notice and the frame of its error box are not part of the error.
NOISE = re.compile(r"new version of glab|/-/releases/v|^ERROR$")
FAILED = ("fail", "cancel")
# Buckets, worst first. Duplicate names (a job and its commit status, or a
# branch and an MR pipeline on one commit) collapse to the worst bucket.
RANK = {"fail": 4, "cancel": 3, "pending": 2, "pass": 1, "skipping": 0}
# Job, commit status, and MR status check states. Anything else is pending.
BUCKETS = {
    "success": "pass", "passed": "pass", "failed": "fail", "canceled": "cancel", "canceling": "cancel",
    "skipped": "skipping", "manual": "skipping",
}
MERGE_STATES = {
    "conflict": "DIRTY", "need_rebase": "BEHIND", "checking": "UNKNOWN", "unchecked": "UNKNOWN",
    "preparing": "UNKNOWN", "approvals_syncing": "UNKNOWN", "cannot_be_merged_recheck": "UNKNOWN",
}
PER_PAGE = 100
MAX_PAGES = 20
MR_URL = re.compile(r"(https?)://([^/\s]+)/([\w.-]+(?:/[\w.-]+)+)/-/merge_requests/(\d+)(?:[/?#]\S*)?")
PROJECT_URL = re.compile(r"(https?)://([^/\s]+)/([\w.-]+(?:/[\w.-]+)+)/?")
PROJECT_PATH = re.compile(r"[\w.-]+(?:/[\w.-]+)+")
MR_REF = re.compile(r"(?:([\w.-]+(?:/[\w.-]+)+)!|[!#])?(\d+)")

# Fields that older or Free-tier instances may lack. A query that names a
# missing field fails as a whole, so each one is dropped on its first error.
OPTIONAL = {
    "approvedBy": "approvedBy { nodes { username bot } }",
    "reviewers": "reviewers { nodes { username bot mergeRequestInteraction { reviewState } } }",
}
OPTIONAL_OWNER = {
    "approvedBy": "approvedBy", "reviewers": "reviewers",
    "mergeRequestInteraction": "reviewers", "reviewState": "reviewers",
}
QUERY = """
query($fullPath: ID!, $iid: String!) {
  currentUser { username }
  project(fullPath: $fullPath) {
    mergeRequest(iid: $iid) {
      %s
      discussions(last: 100) {
        nodes {
          id resolvable resolved
          notes(first: 100) {
            nodes {
              id url body system author { username name bot }
              position { filePath newLine diffRefs { headSha } }
            }
          }
        }
      }
    }
  }
}
"""

Json = dict[str, Any]


class GlabError(Exception):
    def __init__(self, message: str, transient: bool, status: int | None = None, stdout: str = "") -> None:
        super().__init__(message)
        self.transient, self.status, self.stdout = transient, status, stdout


def log(message: str) -> None:
    print(f"pr-wait: {message}", file=sys.stderr, flush=True)


def fail(message: str, code: int = 2) -> NoReturn:
    # Fatal messages go to stdout so a monitor shows the agent why it stopped.
    print(f"pr-wait: {message}", flush=True)
    sys.exit(code)


def run_glab(args: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(["glab", *args], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        fail("glab is not on PATH. Install glab 1.36.0 or newer: https://gitlab.com/gitlab-org/cli")


def glab(args: list[str]) -> str:
    """Run glab and return stdout. Retries transient failures (HTTP 5xx or 429, network) with backoff."""
    delay = 2
    for attempt in range(5):
        proc = run_glab(args)
        status = HTTP_STATUS.search(proc.stderr)
        if proc.returncode == 0 and not status:
            return proc.stdout
        lines = [s for s in (line.strip() for line in proc.stderr.splitlines()) if s and not NOISE.search(s)]
        text = " ".join(lines)
        transient = bool(TRANSIENT.search(text))
        message = next((s for s in lines if HTTP_STATUS.search(s)), text) or f"glab exited {proc.returncode}"
        if not transient or attempt == 4:
            raise GlabError(message, transient, int(status.group(1)) if status else None, proc.stdout)
        log(f"glab {'graphql' if 'graphql' in args else args[-1][:80]}: {message}; retry in {delay}s")
        time.sleep(delay)
        delay *= 2
    raise AssertionError("unreachable")


def api(host_args: list[str], path: str) -> Any:
    out = glab(["api", *host_args, path])
    try:
        return json.loads(out)
    except ValueError:
        raise GlabError(f"glab api {path} returned no JSON: {out[:100]!r}", True) from None


def pages(host_args: list[str], path: str) -> list[Json]:
    rows: list[Json] = []
    sep = "&" if "?" in path else "?"
    for page in range(1, MAX_PAGES + 1):
        batch = api(host_args, f"{path}{sep}per_page={PER_PAGE}&page={page}")
        rows.extend(batch)
        if len(batch) < PER_PAGE:
            break
    return rows


def bot_name(text: str | None) -> str | None:
    """Which review bot a username, display name, or check name belongs to, if any."""
    lowered = (text or "").lower()
    return next((bot for bot in GATING_BOTS + ADVISORY_BOTS if bot in lowered), None)


def who(node: Json) -> tuple[str, bool]:
    author = node.get("author") or {}
    return author.get("username") or "ghost", bool(author.get("bot"))


def bot_of(node: Json) -> str | None:
    # Review bots often post as project or group access-token users named
    # project_N_bot_..., so the display name carries the bot's identity.
    author = node.get("author") or {}
    return bot_name(author.get("username")) or bot_name(author.get("name"))


def is_status_bot(node: Json) -> bool:
    author = node.get("author") or {}
    names = f"{author.get('username') or ''} {author.get('name') or ''}".lower()
    return bool(author.get("bot")) and any(b in names for b in STATUS_BOTS)


def plain(body: str) -> str:
    body = re.sub(r"<!--.*?-->", " ", body or "", flags=re.DOTALL)
    return html.unescape(re.sub(r"<[^>]+>", " ", body))


def snippet(body: str, limit: int = 100) -> str:
    text = re.sub(r"\s+", " ", plain(body)).strip()
    return text if len(text) <= limit else text[: limit - 3] + "..."


def verdict(body: str) -> str:
    """The verdict line of a bot summary (Macroscope, Greptile), if it has one."""
    for line in plain(body).splitlines():
        if re.search(r"verdict|confidence score", line, re.IGNORECASE):
            return snippet(line.replace("*", ""), 80)
    return ""


def digest(body: str) -> str:
    return hashlib.sha1(re.sub(r"\s+", " ", plain(body)).encode()).hexdigest()[:12]


def check(name: str, status: str, link: str | None, description: str | None, allow_failure: bool) -> Json:
    bucket = BUCKETS.get(status, "pending")
    if bucket == "fail" and allow_failure:
        bucket = "pass"
    # Jobs allowed to fail and manual jobs never block a pipeline, so they never gate.
    gates = not allow_failure and status != "manual"
    return {"name": name, "bucket": bucket, "link": link or "", "description": description or status, "gates": gates}


def host_of(url: str) -> str:
    return urlparse(url if "://" in url else f"https://{url}").netloc.lower()


@dataclass
class Target:
    host: str
    project: str
    iid: int
    host_args: list[str]

    @property
    def ref(self) -> str:
        return f"{self.project}!{self.iid}"

    @property
    def key(self) -> str:
        return f"{self.host}__{self.project}__{self.iid}".replace("/", "__").replace(":", "_")


def route(host: str | None, scheme: str, default: str | None) -> list[str]:
    """glab flags that reach host with the user's token. glab sends a token only
    to GITLAB_HOST and to hosts in its config, and --hostname rejects host:port."""
    if host is None or host == default:
        return []
    if ":" in host:
        fail(
            f"glab cannot address {host} with --hostname because it has a port. "
            f"Run pr-wait with GITLAB_HOST={scheme}://{host}, and GITLAB_TOKEN unless glab has a login for it."
        )
    try:
        proc = subprocess.run(
            ["glab", "auth", "status", "--hostname", host],
            capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=60,
        )
    except FileNotFoundError:
        fail("glab is not on PATH. Install glab 1.36.0 or newer: https://gitlab.com/gitlab-org/cli")
    except subprocess.TimeoutExpired:
        return ["--hostname", host]
    # Exit codes differ across glab versions; this wording does not.
    if re.search(r"not (been )?authenticated with glab", re.sub(r"\s+", " ", proc.stdout + proc.stderr)):
        fail(
            f"glab has no login for {host}, so its calls there would carry no token. "
            f"Run `glab auth login --hostname {host}`, or set GITLAB_HOST={scheme}://{host} and GITLAB_TOKEN."
        )
    return ["--hostname", host]


def parse_target(raw: str | None, repo: str | None) -> Target:
    if raw is None or not raw.strip():
        fail("missing MR IID. Did a variable expand to nothing? Usage: pr-wait <mr> [--repo group/project]")
    host: str | None = None
    scheme = "https"
    repo_url = PROJECT_URL.fullmatch(repo.strip()) if repo else None
    if repo_url:
        scheme, host, repo = repo_url.group(1), repo_url.group(2).lower(), re.sub(r"\.git$", "", repo_url.group(3))
    url = MR_URL.fullmatch(raw.strip())
    ref = MR_REF.fullmatch(raw.strip())
    if url:
        if host is None:
            scheme, host = url.group(1), url.group(2).lower()
        repo = repo or url.group(3)
        iid = int(url.group(4))
    elif ref:
        repo = repo or ref.group(1)
        iid = int(ref.group(2))
    else:
        fail(f"'{raw}' is not an MR IID or MR URL")
    if iid <= 0:
        fail(f"'{raw}' is not a valid MR IID")
    default = host_of(os.environ["GITLAB_HOST"].strip()) if os.environ.get("GITLAB_HOST", "").strip() else None
    host = host or default
    host_args = route(host, scheme, default)
    if not repo:
        try:
            repo = api(host_args, "projects/:fullpath")["path_with_namespace"]
        except GlabError as error:
            fail(f"no --repo given and the current directory has no GitLab project ({error})")
    if not PROJECT_PATH.fullmatch(repo):
        fail(f"'{repo}' is not a group/project path")
    try:
        mr = api(host_args, f"projects/{quote(repo, safe='')}/merge_requests/{iid}")
        host = host or host_of(mr["web_url"])
    except GlabError as error:
        if not error.transient:  # a transient failure is retried by the poll loop
            fail(f"cannot read {repo}!{iid}: {error}")
        if host is None:
            fail(f"cannot read {repo}!{iid}: GitLab unreachable: {error}", 1)
    return Target(host, repo, iid, host_args)


def lock(target: Target) -> Any:
    """Hold a per-MR lock for the life of the process. The OS drops it on exit."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    handle = open(STATE_DIR / f"{target.key}.lock", "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.seek(0)
        pid = handle.read().strip() or "unknown"
        fail(
            f"pid {pid} already watches {target.host}/{target.ref}, so this watcher exits to avoid "
            f"duplicate events. If no events reach you from it, run `kill {pid}` and start again."
        )
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    return handle


class Watcher:
    def __init__(self, target: Target, until: str, interval: int) -> None:
        self.target, self.until, self.interval = target, until, interval
        self.project_api = f"projects/{quote(target.project, safe='')}"
        self.mr_api = f"{self.project_api}/merge_requests/{target.iid}"
        self.path = STATE_DIR / f"{target.key}.json"
        state = self.load()
        # First run for this MR: record what exists and report nothing.
        self.baseline = state is None
        self.state: Json = state or {"reported": [], "summaries": {}, "base_oid": None, "merge_state": None}
        self.reported: set[str] = set(self.state["reported"])
        self.printed: set[str] = set()
        self.events = 0
        self.must_succeed: bool | None = None
        self.status_checks = True
        self.optional = list(OPTIONAL)
        self.prev_snapshot: list[tuple[str, str]] | None = None
        self.mr_files: dict[str, set[str]] = {}
        self.web_url = ""

    def load(self) -> Json | None:
        try:
            if time.time() - self.path.stat().st_mtime > STALE_STATE_SECONDS:
                return None
            return json.loads(self.path.read_text())
        except (OSError, ValueError):
            return None

    def save(self) -> None:
        self.state["reported"] = sorted(self.reported)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state))
        tmp.replace(self.path)

    def say(self, line: str) -> None:
        if line not in self.printed:
            self.printed.add(line)
            print(f"!{self.target.iid} {line}", flush=True)

    def emit(self, key: str, line: str) -> None:
        """Print an event once per MR, across restarts."""
        if key in self.reported:
            return
        self.reported.add(key)
        if not self.baseline:
            self.events += 1
            self.say(line)

    def finish(self, code: int, lines: Sequence[str] = ()) -> NoReturn:
        for line in lines:
            self.say(line)
        self.save()
        sys.exit(code)

    def api(self, path: str) -> Any:
        return api(self.target.host_args, path)

    def pages(self, path: str) -> list[Json]:
        return pages(self.target.host_args, path)

    def link(self, note: Json) -> str:
        return note.get("url") or f"{self.web_url}#note_{str(note['id']).rsplit('/', 1)[-1]}"

    def fetch_mr(self) -> Json:
        return self.api(f"{self.mr_api}?include_diverged_commits_count=true")

    def fetch_graphql(self) -> Json:
        while True:
            query = QUERY % " ".join(OPTIONAL[name] for name in self.optional)
            args = ["api", *self.target.host_args, "graphql", "-f", f"query={query}",
                    "-f", f"fullPath={self.target.project}", "-f", f"iid={self.target.iid}"]
            try:
                data = json.loads(glab(args))
            except GlabError as error:
                try:
                    data = json.loads(error.stdout)
                except ValueError:
                    data = {}
                if error.transient or not isinstance(data, dict) or not data.get("errors"):
                    raise
            except ValueError:
                raise GlabError("glab api graphql returned no JSON", True) from None
            errors = " ".join(str(e.get("message", "")) for e in data.get("errors") or [])
            missing = {OPTIONAL_OWNER[f] for f in re.findall(r"Field '(\w+)' doesn't exist", errors) if f in OPTIONAL_OWNER}
            missing &= set(self.optional)
            if missing:
                log(f"this GitLab has no {', '.join(sorted(missing))} in GraphQL; watching without it")
                self.optional = [name for name in self.optional if name not in missing]
                continue
            mr = ((data.get("data") or {}).get("project") or {}).get("mergeRequest")
            if mr is None:
                raise GlabError(errors or f"GraphQL cannot see {self.target.ref}", False)
            return data["data"]

    def setup(self) -> None:
        """Log what gates this MR, once per run."""
        try:
            project = self.api(self.project_api)
            self.must_succeed = bool(project.get("only_allow_merge_if_pipeline_succeeds"))
        except GlabError as error:
            if error.transient:
                raise
            log(f"could not read project settings: {error}")
            self.must_succeed = False
        log(
            f"watching {self.target.host}/{self.target.ref} until {self.until}; "
            f"pipeline must succeed: {'yes' if self.must_succeed else 'no'}; "
            "jobs that may not fail, external statuses, and MR status checks gate"
        )

    def fetch_checks(self, mr: Json) -> dict[str, Json]:
        rows: list[Json] = []
        # A merged results pipeline runs on a merge commit, so its sha is not the head.
        pipeline = mr.get("head_pipeline")
        if pipeline:
            base = f"projects/{pipeline.get('project_id') or mr['source_project_id']}/pipelines/{pipeline['id']}"
            for kind in ("jobs", "bridges"):
                for job in self.pages(f"{base}/{kind}"):
                    rows.append(check(job["name"], job["status"], job.get("web_url"), job["status"], bool(job.get("allow_failure"))))
        jobs = {row["name"] for row in rows}
        try:
            statuses = self.pages(f"projects/{mr['source_project_id']}/repository/commits/{mr['sha']}/statuses")
        except GlabError as error:
            if error.status not in (403, 404):  # a fork you cannot read
                raise
            log(f"could not read commit statuses: {error}")
            statuses = []
        for status in statuses:
            link = status.get("target_url") or ""
            # CI jobs are commit statuses too. Only external ones are new here.
            if status["name"] in jobs or "/-/jobs/" in link:
                continue
            rows.append(check(status["name"], status["status"], link, status.get("description"), bool(status.get("allow_failure"))))
        if self.status_checks:
            try:
                for item in self.api(f"{self.mr_api}/status_checks"):
                    rows.append(check(item["name"], item["status"], item.get("external_url"), item["status"], False))
            except GlabError as error:
                if error.status not in (401, 403, 404):  # MR status checks need Ultimate
                    raise
                self.status_checks = False
        checks: dict[str, Json] = {}
        for row in rows:
            current = checks.get(row["name"])
            if current is None or RANK[row["bucket"]] > RANK[current["bucket"]]:
                checks[row["name"]] = row
        return checks

    def fetch_base_oid(self, base: str) -> str | None:
        try:
            return self.api(f"{self.project_api}/repository/branches/{quote(base, safe='')}")["commit"]["id"]
        except GlabError as error:
            if error.transient:
                raise
            log(f"could not read {base}: {error}")
            return None

    def base_overlap(self, head: str, old: str, new: str) -> list[str]:
        """Files this MR touches that the new target branch commits also touch."""
        def paths(diffs: list[Json]) -> set[str]:
            return {p for d in diffs for p in (d.get("old_path"), d.get("new_path")) if p}

        try:
            if head not in self.mr_files:
                self.mr_files[head] = paths(self.pages(f"{self.mr_api}/diffs"))
            moved = paths(self.api(f"{self.project_api}/repository/compare?from={old}&to={new}").get("diffs") or [])
        except GlabError as error:
            log(f"could not compare target branch commits: {error}")
            return []
        return sorted(self.mr_files[head].intersection(moved))

    def behind(self, base: str, mr: Json) -> str:
        """How far the head is behind its target, for the green and ready lines."""
        count = mr.get("diverged_commits_count")
        if count is None:
            return ""
        return f"; {count} commit{'' if count == 1 else 's'} behind {base}"

    def poll(self) -> None:
        mr = self.fetch_mr()
        self.web_url = mr["web_url"]
        if mr["state"] == "merged":
            self.finish(0, [f"merged: {mr['web_url']}"])
        if mr["state"] == "closed":
            self.finish(1, [f"closed without merging: {mr['web_url']}"])

        base = mr["target_branch"]
        if self.must_succeed is None:
            self.setup()
        node = self.fetch_graphql()
        checks = self.fetch_checks(mr)
        head = mr["sha"]
        short = head[:7]
        mr_node = node["project"]["mergeRequest"]
        mine = {(mr.get("author") or {}).get("username"), (node.get("currentUser") or {}).get("username")} - {None}
        discussions = mr_node["discussions"]["nodes"]
        notes = [(d, [n for n in d["notes"]["nodes"] if not n.get("system")]) for d in discussions]
        comments = [n for d, ns in notes if not d.get("resolvable") for n in ns]
        threads = [(d, ns) for d, ns in notes if d.get("resolvable") and ns]
        approvers = (mr_node.get("approvedBy") or {}).get("nodes") or []
        reviewers = (mr_node.get("reviewers") or {}).get("nodes") or []
        self.events = 0

        # Jobs that may not fail gate, except the review bots' own checks.
        gate = {name for name, c in checks.items() if c["gates"] and not bot_name(name)}
        label = "required check" if self.must_succeed else "check"

        def bucket(name: str) -> str:
            return checks[name]["bucket"] if name in checks else "pending"

        fail_lines: list[str] = []
        for name in sorted(gate):
            if bucket(name) in FAILED:
                link = checks[name]["link"]
                fail_lines.append(f"{label} failed: {name} {link}")
                self.emit(f"fail:{head}:{name}:{link}", fail_lines[-1])
        watched = {name: c for name, c in checks.items() if bot_name(name) not in ADVISORY_BOTS}
        gate_done = bool(gate) and all(bucket(n) != "pending" for n in gate)
        all_done = gate_done and all(c["bucket"] != "pending" for c in watched.values())
        # Jobs appear a few seconds after a push. Two identical polls in a row
        # guard against calling a half-created pipeline finished.
        snapshot = sorted((name, c["bucket"]) for name, c in watched.items())
        stable = snapshot == self.prev_snapshot
        self.prev_snapshot = snapshot
        green = gate_done and stable and not fail_lines

        # People and bots talking. Edits and system notes are never events.
        for comment in comments:
            login, _ = who(comment)
            if login in mine or bot_of(comment) or is_status_bot(comment):
                continue
            self.emit(f"c:{comment['id']}", f"comment from {login}: {snippet(comment['body'])} {self.link(comment)}")
        for user in approvers:
            if user["username"] in mine or user.get("bot"):
                continue
            self.emit(f"review:{user['username']}:approved:{head}", f"review from {user['username']} (approved) {mr['web_url']}")
        for user in reviewers:
            state = (user.get("mergeRequestInteraction") or {}).get("reviewState")
            if state != "REQUESTED_CHANGES" or user["username"] in mine or user.get("bot"):
                continue
            self.emit(
                f"review:{user['username']}:requested_changes:{head}",
                f"review from {user['username']} (changes requested) {mr['web_url']}",
            )
        unresolved: list[str] = []
        for discussion, thread in threads:
            if not discussion.get("resolved"):
                unresolved.append(self.link(thread[0]))
            position = thread[0].get("position") or {}
            where = f"{position.get('filePath')}:{position['newLine']}" if position.get("newLine") else position.get("filePath") or ""
            for index, note in enumerate(thread):
                login, _ = who(note)
                if login in mine:
                    continue
                kind = "new thread" if index == 0 else "thread reply"
                on = f" on {where}" if where else ""
                self.emit(f"c:{note['id']}", f"{kind} from {login}{on}: {snippet(note['body'])} {self.link(note)}")

        # Review bots on the current head. A bot with checks is done when they
        # finish. Otherwise it is done once it leaves diff notes on the head
        # commit or its summary names the head.
        bot_status: dict[str, str] = {}
        reviewed: list[str] = []
        all_notes = [n for _, ns in notes for n in ns]
        for bot in GATING_BOTS + ADVISORY_BOTS:
            own_checks = {name: c for name, c in checks.items() if bot_name(name) == bot}
            summaries = [n for n in all_notes if bot_of(n) == bot and not n.get("position")]
            diff_notes = [n for n in all_notes if bot_of(n) == bot and n.get("position")]
            on_head = any(((n["position"].get("diffRefs") or {}).get("headSha")) == head for n in diff_notes)
            if own_checks:
                done = all(c["bucket"] != "pending" for c in own_checks.values())
            else:
                done = on_head or any(short in s["body"] for s in summaries)
            seen = bool(own_checks or summaries or diff_notes)
            if bot in ADVISORY_BOTS and own_checks:
                desc = next(iter(own_checks.values()))
                bot_status[bot] = f"{bot} {desc['description'] or desc['bucket']} (advisory)"
            elif seen:
                bot_status[bot] = f"{bot} {'done' if done else 'pending'}{' (advisory)' if bot in ADVISORY_BOTS else ''}"
            key = f"bot:{bot}:{head}"
            was_done = key in self.reported
            if done:
                if bot in GATING_BOTS:
                    reviewed.append(bot)
                failed = [name for name, c in own_checks.items() if c["bucket"] in FAILED]
                detail = "; ".join(filter(None, [
                    next((v for v in map(verdict, (s["body"] for s in summaries)) if v), ""),
                    f"failed: {', '.join(failed)}" if failed else "",
                ]))
                tag = " (advisory, not waited on)" if bot in ADVISORY_BOTS else ""
                self.emit(key, f"{bot} finished on {short}{': ' + detail if detail else ''}{tag}")
            if bot in GATING_BOTS:
                for s in summaries:
                    new, old = digest(s["body"]), self.state["summaries"].get(s["id"])
                    self.state["summaries"][s["id"]] = new
                    if was_done and old and old != new:
                        text = verdict(s["body"]) or snippet(s["body"])
                        self.emit(f"summary:{s['id']}:{new}", f"{bot} summary changed on {short}: {text} {self.link(s)}")

        # Target branch and merge state.
        base_oid = self.fetch_base_oid(base)
        old_base = self.state["base_oid"]
        if base_oid and old_base and base_oid != old_base and not self.baseline:
            touched = self.base_overlap(head, old_base, base_oid)
            if touched:
                more = f" and {len(touched) - 5} more" if len(touched) > 5 else ""
                self.emit(
                    f"base:{base_oid}",
                    f"{base} moved to {base_oid[:7]} and touches files in this MR: {', '.join(touched[:5])}{more}",
                )
        if base_oid:
            self.state["base_oid"] = base_oid
        detailed = mr.get("detailed_merge_status") or mr.get("merge_status") or "unchecked"
        merge_state = "DIRTY" if mr.get("has_conflicts") else MERGE_STATES.get(detailed, detailed)
        dirty_line = f"merge state is DIRTY (conflict): the branch conflicts with {base}, rebase it"
        behind_line = f"merge state is BEHIND (need_rebase): rebase the branch onto {base} before merging"
        if merge_state != "UNKNOWN":
            if merge_state in ("BEHIND", "DIRTY") and self.state["merge_state"] != merge_state:
                line = dirty_line if merge_state == "DIRTY" else behind_line
                self.emit(f"merge:{merge_state}:{head}:{base_oid}", line)
            self.state["merge_state"] = merge_state

        # One summary line per head once all jobs finish.
        counts: dict[str, int] = {}
        for c in watched.values():
            counts[c["bucket"]] = counts.get(c["bucket"], 0) + 1
        failed_names = sorted(name for name, c in watched.items() if c["bucket"] in FAILED)
        parts = [
            ", ".join(f"{n} {b}" for b, n in sorted(counts.items()))
            + (f" ({', '.join(failed_names)})" if failed_names else ""),
            f"required {sum(bucket(n) in ('pass', 'skipping') for n in gate)}/{len(gate)} green"
            if self.must_succeed
            else "",
            ", ".join(bot_status[b] for b in GATING_BOTS + ADVISORY_BOTS if b in bot_status)
            or "no Greptile or Macroscope yet",
            f"{len(unresolved)} unresolved threads",
            f"merge state {merge_state}",
        ]
        summary = "; ".join(p for p in parts if p)
        checks_key = f"checks:{head}"

        # Decide whether to stop. A green or ready line carries the same summary
        # as the checks line, so it marks that event as reported.
        if self.until != "any-change":
            if merge_state == "DIRTY":
                self.finish(1, [dirty_line])
            if fail_lines:
                self.finish(1, fail_lines)
            if green and self.until == "green":
                self.reported.add(checks_key)
                self.finish(0, [f"green on {short}: {summary}{self.behind(base, mr)}"])
            # ready waits for Greptile or Macroscope, never for CodeRabbit.
            if green and reviewed:
                if unresolved:
                    self.finish(1, [f"blocked by {len(unresolved)} unresolved threads on {short}: {' '.join(unresolved)}"])
                if merge_state == "BEHIND":
                    self.finish(1, [behind_line])
                self.reported.add(checks_key)
                self.finish(0, [f"ready on {short}: {summary}{self.behind(base, mr)}"])
        if all_done and (stable or self.baseline):
            self.emit(checks_key, f"checks finished on {short}: {summary}")
        if self.until == "any-change" and self.events:
            self.finish(0)

    def run(self) -> NoReturn:
        failures = 0
        while True:
            try:
                self.poll()
                failures = 0
            except GlabError as error:
                if error.status == 401:
                    self.finish(1, [
                        f"pr-wait stopped: {error}. glab has no valid token for {self.target.host}: "
                        f"run `glab auth login --hostname {self.target.host}`, or set GITLAB_TOKEN"
                    ])
                if not error.transient:
                    self.finish(1, [f"pr-wait stopped: {error}"])
                failures += 1
                log(f"poll failed ({failures}/{MAX_FAILED_POLLS}): {error}")
                if failures >= MAX_FAILED_POLLS:
                    self.finish(1, [f"pr-wait stopped: GitLab unreachable for {failures} polls: {error}"])
            else:
                self.save()
                if self.baseline:
                    log(f"baseline recorded for {self.target.ref}; reporting only new events")
                self.baseline = False
            time.sleep(self.interval)


def main() -> None:
    parser = argparse.ArgumentParser(prog="pr-wait", description="Watch a GitLab merge request and print one line per real event.")
    parser.add_argument("mr", nargs="?", help="MR IID (123 or !123), group/project!123, or MR URL")
    parser.add_argument("-R", "--repo", help="group/project path or project URL (default: from the URL or the current checkout)")
    parser.add_argument("--until", choices=("green", "ready", "any-change"), default="ready")
    parser.add_argument("--interval", type=int, default=20, help="seconds between polls (default 20, min 5)")
    args = parser.parse_args()
    target = parse_target(args.mr, args.repo)
    _lock = lock(target)
    Watcher(target, args.until, max(args.interval, 5)).run()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
