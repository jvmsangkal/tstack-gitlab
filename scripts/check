#!/bin/sh
# Run every repo check. Used locally and by GitHub Actions and GitLab CI.
set -eu

cd "$(dirname "$0")/.."
export PYTHONDONTWRITEBYTECODE=1

pr_wait=skills/babysit-pr/scripts/pr-wait

echo "==> compile $pr_wait"
# compile() rather than py_compile: py_compile writes __pycache__ into skills/,
# which the README install copies to users.
python3 -c 'import sys; compile(open(sys.argv[1]).read(), sys.argv[1], "exec")' "$pr_wait"

echo "==> $pr_wait --help"
"$pr_wait" --help >/dev/null

echo "==> unittest"
set -- tests/test*.py
if [ -e "$1" ]; then
  python3 -m unittest discover -s tests
else
  echo "no tests/test*.py; skipping"
fi

echo "==> ok"
